# Copia este archivo como .env.local y ajusta los valores.
# Vite solo expone al navegador las variables con prefijo VITE_.
# Nunca pongas secretos aqui: todo lo que empieza con VITE_ queda en el bundle.

# De donde salen los datos y la autenticacion.
#   local -> localStorage del navegador. Funciona sin backend. Valor por defecto.
#   api   -> el backend HTTP definido en VITE_API_URL.
VITE_MODO_DATOS=local

# URL base del backend. Sin diagonal final.
# Si activas el proxy de vite.config.ts, usa /api en su lugar.
VITE_API_URL=http://localhost:8080

# Donde se guarda el token de sesion cuando VITE_MODO_DATOS=api.
#   local   -> localStorage. Sobrevive al cierre del navegador.
#   sesion  -> sessionStorage. Se borra al cerrar la pestana.
#   memoria -> solo en memoria. Lo mas seguro; obliga a entrar en cada recarga.
# Si el backend usa cookies httpOnly, pon memoria y activa VITE_AUTH_COOKIES.
VITE_TOKEN_ALMACEN=local

# true cuando el backend maneja la sesion con cookies httpOnly en vez de
# devolver un token en el cuerpo. Hace que el cliente mande credentials:include.
VITE_AUTH_COOKIES=false
